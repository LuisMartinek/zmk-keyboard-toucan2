#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de.h"

#define BASE 0
#define SYM  1
#define NUM  2
#define SYS  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 3>;
            then-layer = <2>;
        };
    };

    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <2 0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 3 38>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <10 6 7 8 18 19 9 11 23 22 21 20 32 33 34 35 31 30 40 41 39>;
        };

        HMHoldPreferredL: HMHoldPreferredL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMHOLDPREFERREDL";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39>;
            tapping-term-ms = <200>;
        };

        HMHoldPreferredR: HMHoldPreferredR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMHOLDPREFERREDR";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 12 13 24 25 27 26 14 2 3 15 17 4 5 16 28 29 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Z  &kp U  &kp I  &kp O  &kp P  &kp DE_U_UMLAUT  &kp ESC  &HML LCTRL DE_A  &HML LEFT_ALT DE_S  &HMHoldPreferredL 1 DE_D  &HML LEFT_META F  &kp G  &kp H  &HMR LEFT_META DE_J  &HMHoldPreferredR 1 DE_K  &HMR LEFT_ALT DE_L  &HMR LCTRL DE_O_UMLAUT  &kp DE_A_UMLAUT  &kp LSHFT  &kp Y  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp DE_COMMA  &kp DE_DOT  &kp DE_MINUS  &kp RIGHT_SHIFT  &kp LEFT_SHIFT  &mo 1  &kp RET  &kp BSPC  &lt 2 SPACE  &kp RIGHT_SHIFT
            >;
        };

        nav {
            display-name = "SYM";
            bindings = <
&trans  &kp DE_AT  &kp DE_DQT  &kp SQT  &kp DE_CARET  &kp DE_PRCNT  &kp DE_TILDE  &kp PIPE  &kp DE_PLUS  &kp EQUAL  &kp DE_BSLH  &trans  &trans  &kp EXCLAMATION  &kp QMARK  &kp DE_LT  &kp DE_GT  &kp DE_DLLR  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DE_ASTRK  &trans  &trans  &kp DE_LBKT  &kp DE_RBKT  &kp DE_LPAR  &kp DE_RPAR  &trans  &kp DE_GRAVE  &kp DE_HASH  &kp DE_LBRC  &kp DE_RBRC  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        adj {
            display-name = "NUM";
            bindings = <
&trans  &kp DE_COMMA  &kp DE_N7  &kp DE_N8  &kp DE_N9  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &kp DE_N0  &kp DE_N4  &kp DE_N5  &kp DE_N6  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans  &trans  &kp DE_DOT  &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_COLON  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sym {
            display-name = "SYS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
